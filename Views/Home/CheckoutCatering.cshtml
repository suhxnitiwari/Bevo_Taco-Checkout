@model Tiwari_Suhani_HW2.Models.CateringOrder

@{
    ViewData["Title"] = "Catering Checkout";
}


<div class="bevo-card">
    <div class="text-center">
        <h1 class="bevo-headline-page text-bevo-maroon">
            Catering Order
            <span class="bevo-underline bevo-underline-page bevo-underline-maroon"></span>
        </h1>
        <p class="bevo-subtitle">Let's feed your crew!</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mb-3" role="alert">@ViewBag.Error</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-action="CateringTotals" class="bevo-form">
        <div class="form-group">
            <label asp-for="CustomerCode" class="control-label"></label>
            <input asp-for="CustomerCode" class="form-control" />
            <span asp-validation-for="CustomerCode" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NumberOfTacos" class="control-label"></label>
            <input asp-for="NumberOfTacos" class="form-control" min="0" />
            <span asp-validation-for="NumberOfTacos" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NumberOfBurgers" class="control-label"></label>
            <input asp-for="NumberOfBurgers" class="form-control" min="0" />
            <span asp-validation-for="NumberOfBurgers" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DeliveryFee" class="control-label"></label>
            <input asp-for="DeliveryFee" class="form-control" min="0" max="250" step="0.01" />
            <span asp-validation-for="DeliveryFee" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input class="form-check-input" asp-for="PreferredCustomer" />
            <label class="form-check-label" asp-for="PreferredCustomer"></label>
        </div>
        <div class="form-group text-center">
            <button type="submit" class="btn-checkout btn-checkout-catering">Checkout &rarr;</button>
        </div>
    </form>
</div>

<div class="text-center">
    <a asp-action="Index" class="bevo-back-link">&larr; Back to Home</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
