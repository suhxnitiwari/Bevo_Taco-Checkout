@model CartViewModel
@{
    ViewData["Title"] = "Your Cart";
    var priced = Model.Priced;
    var subtotal = priced.Subtotal;
    var toFree = CateringOrder.FreeDeliveryThreshold - subtotal;
    var pct = Math.Min(100m, subtotal / CateringOrder.FreeDeliveryThreshold * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="bevo-panel">
    <div class="bevo-page-head">
        <div>
            <p class="bevo-eyebrow">Cart</p>
            <h1 class="bevo-page-title">Your order</h1>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="bevo-link">← Keep browsing</a>
    </div>

    @foreach (var problem in priced.Problems)
    {
        <div class="bevo-flash bevo-flash-error">@problem</div>
    }

    @if (Model.Cart.Count == 0)
    {
        <p class="bevo-empty">Your cart is empty. <a asp-controller="Menu" asp-action="Index">Browse the menu</a>.</p>
    }
    else
    {
        <table class="bevo-table bevo-cart-table">
            <thead><tr><th>Item</th><th class="num">Each</th><th class="num">Qty</th><th class="num">Total</th></tr></thead>
            <tbody>
            @foreach (var line in Model.Cart)
            {
                var priceLine = priced.ByKey.GetValueOrDefault(line.Key);
                <tr class="@(priceLine is null ? "unavailable" : "")">
                    <td>
                        <b>@(priceLine?.ItemName ?? "Unavailable item")</b>
                        @if (!string.IsNullOrEmpty(priceLine?.AddOnSummary)) { <small>@priceLine.AddOnSummary</small> }
                    </td>
                    <td class="num">@(priceLine?.UnitPrice.ToString("c") ?? "—")</td>
                    <td class="num">
                        <form asp-action="Update" method="post" class="bevo-qty-form">
                            <input type="hidden" name="key" value="@line.Key" />
                            <button type="submit" name="quantity" value="@(line.Quantity - 1)" aria-label="One fewer">−</button>
                            <span>@line.Quantity</span>
                            <button type="submit" name="quantity" value="@(line.Quantity + 1)" aria-label="One more">+</button>
                            <button type="submit" name="quantity" value="0" class="bevo-remove" aria-label="Remove">✕</button>
                        </form>
                    </td>
                    <td class="num">@(priceLine?.LineTotal.ToString("c") ?? "—")</td>
                </tr>
            }
            </tbody>
            <tfoot><tr><th colspan="3">Subtotal (@priced.ItemCount items)</th><th class="num">@subtotal.ToString("c")</th></tr></tfoot>
        </table>

        <div class="bevo-checkout-choice">
            <div class="bevo-choice">
                <h2>🌮 Walk-up pickup</h2>
                <p>Pay at the window. 8.25% sales tax, tip optional. No account needed.</p>
                <a asp-controller="Checkout" asp-action="Walkup" class="btn-checkout btn-checkout-walkup">Walk-up checkout →</a>
            </div>
            <div class="bevo-choice">
                <h2>🎉 Catering delivery</h2>
                <p>
                    Needs a customer account and 2 days' notice.
                    @if (toFree > 0) { <text>Add <b>@toFree.ToString("c")</b> more for free delivery.</text> }
                    else { <text><b>Free delivery unlocked!</b></text> }
                </p>
                <div class="bevo-meter" role="img" aria-label="@pct% of the way to free delivery">
                    <span style="width:@pct%"></span>
                </div>
                <a asp-controller="Checkout" asp-action="Catering" class="btn-checkout btn-checkout-catering">Catering checkout →</a>
            </div>
        </div>

        <form asp-action="Clear" method="post" class="text-center mt-3">
            <button type="submit" class="bevo-link-btn">Clear cart</button>
        </form>
    }
</div>
