@model BevosTacos.Models.WalkupOrder

@{
    ViewData["Title"] = "Walkup Checkout";
}


<div class="bevo-card">
    <div class="text-center">
        <h1 class="bevo-headline-page text-bevo-orange">
            Walk-Up Order
            <span class="bevo-underline bevo-underline-page bevo-underline-orange"></span>
        </h1>
        <p class="bevo-subtitle">Fresh off the truck!</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <form asp-action="WalkupTotals" class="bevo-form">
        <div class="form-group">
            <label asp-for="CustomerName" class="control-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NumberOfTacos" class="control-label"></label>
            <input asp-for="NumberOfTacos" class="form-control" min="0" />
            <span asp-validation-for="NumberOfTacos" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NumberOfBurgers" class="control-label"></label>
            <input asp-for="NumberOfBurgers" class="form-control" min="0" />
            <span asp-validation-for="NumberOfBurgers" class="text-danger"></span>
        </div>
        <div class="form-group text-center">
            <button type="submit" class="btn-checkout btn-checkout-walkup">Checkout &rarr;</button>
        </div>
    </form>
</div>

<div class="text-center">
    <a asp-action="Index" class="bevo-back-link">&larr; Back to Home</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
